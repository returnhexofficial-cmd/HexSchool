/// A contact-form submission. Anonymous writes are reCAPTCHA-verified and
/// rate-limited; the office reads them in the CMS inbox. A REPLIED row
/// must record when it was replied to (CHECK — the "evidence, not a bare
/// flag" rule M16/M17 established).
model ContactMessage {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String               @map("school_id") @db.Uuid
  school    School               @relation(fields: [schoolId], references: [id], map: "fk_contact_messages_school")
  name      String               @db.VarChar(150)
  phone     String?              @db.VarChar(20)
  email     String?              @db.VarChar(150)
  subject   String?              @db.VarChar(200)
  body      String
  status    ContactMessageStatus @default(NEW)
  ip        String?              @db.VarChar(64)
  readAt    DateTime?            @map("read_at") @db.Timestamptz(6)
  repliedAt DateTime?            @map("replied_at") @db.Timestamptz(6)
