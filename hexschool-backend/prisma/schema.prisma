enum FeeOverrideType {
  DISCOUNT_PERCENT
  DISCOUNT_FLAT
  WAIVER
  SCHOLARSHIP

  @@map("fee_override_type_enum")
}

/// An invoice's money state. OVERDUE is derived by the nightly job from
