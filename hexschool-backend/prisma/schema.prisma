/// against a queue; this is that queue.
enum BookReservationStatus {
  ACTIVE
  READY
  FULFILLED
  CANCELLED
  EXPIRED

  @@map("book_reservation_status_enum")
}

/// The physical stock-take (roadmap §4 "scan-all, diff report").
