/// One image or embedded video inside a gallery. Paginated on the public
/// side (roadmap §8 — a very large album loads its items in pages).
///
/// HARD-deleted, unlike every other content table here: an album's items
/// are edited as a set (the incoming list replaces what is there), so a
/// tombstone would only ever be dead weight — the M13 `timetable_entries`
/// / M14 `seat_plan_entries` precedent for wholesale-replaced child rows.
model GalleryItem {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String          @map("school_id") @db.Uuid
  school       School          @relation(fields: [schoolId], references: [id], map: "fk_gallery_items_school")
  galleryId    String          @map("gallery_id") @db.Uuid
  gallery      Gallery         @relation(fields: [galleryId], references: [id], onDelete: Cascade, map: "fk_gallery_items_gallery")
