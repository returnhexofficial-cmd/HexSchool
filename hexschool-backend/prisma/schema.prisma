// ── Module 20: Accounting & Finance ───────────────────────────────────

/// One node of the chart of accounts. `parent_id` makes it a tree inside
/// its `group`, and `is_group` says whether it is a heading or a place
/// money may actually land: **only leaves take entries** (roadmap M20 §7).
/// The distinction is a column rather than "has no children" because a
/// heading with no children yet must already refuse a posting — otherwise
/// the first entry lands on it and the node can never become a heading.
///
/// `is_system` marks the accounts auto-posting resolves to. They may be
/// renamed but never deleted or deactivated, because a school that
/// deleted "Cash in Hand" would silently stop being able to bank a fee.
model Account {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String    @map("school_id") @db.Uuid
  school   School    @relation(fields: [schoolId], references: [id], map: "fk_accounts_school")
  parentId String?   @map("parent_id") @db.Uuid
  /// Restrict, not SetNull: an account that silently lost its parent
  /// would jump to the root of a statement and quietly restate it.
  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict, map: "fk_accounts_parent")
  children Account[] @relation("AccountTree")

  group  AccountGroup
  type   AccountType  @default(OTHER)
  code   String       @db.VarChar(20)
  name   String       @db.VarChar(150)
  nameBn String?      @map("name_bn") @db.VarChar(150)

  /// Balance carried in when the school adopted the system, in the
  /// account's own natural direction (a debit-normal account's opening
  /// balance is a debit). Headings must carry 0 — a CHECK enforces it.
  openingBalance Decimal @default(0) @map("opening_balance") @db.Decimal(12, 2)
  /// Bank-book identity for a BANK account; NULL everywhere else.
  bankAccountNo  String? @map("bank_account_no") @db.VarChar(60)
  bankName       String? @map("bank_name") @db.VarChar(150)
  branchName     String? @map("branch_name") @db.VarChar(150)

  isGroup      Boolean @default(false) @map("is_group")
  isSystem     Boolean @default(false) @map("is_system")
  isActive     Boolean @default(true) @map("is_active")
  description  String? @db.VarChar(500)
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  entries     VoucherEntry[]
  budgets     Budget[]
  postingMaps PostingMap[]

  // `uq_accounts_code` is partial (live rows only) and hand-written —
  // deleting an account frees its code for reuse, unlike a document
  // number, because a code is a filing position and not a receipt.
  @@index([schoolId, group, code], map: "idx_accounts_group_code")
  @@index([parentId], map: "idx_accounts_parent")
  @@map("accounts")
}

/// The document. A POSTED voucher is immutable (roadmap M20 §6) —
/// correcting one means cancelling it, which writes a mirror-image
/// reversal voucher linked back through `reversal_of_voucher_id`, so the
/// ledger keeps both sides and the trial balance never rewinds.
///
/// `source_ref` is the machine idempotency key for auto-posting
/// (`payment:<uuid>`, `refund:<uuid>`, later `payroll:<uuid>`). A partial
/// unique over it is what makes a replayed event, a reconciliation sweep
/// and a double-clicked callback all land one voucher instead of three.
model Voucher {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String @map("school_id") @db.Uuid
  school    School @relation(fields: [schoolId], references: [id], map: "fk_vouchers_school")
  voucherNo String @map("voucher_no") @db.VarChar(30)

  type   VoucherType
  source VoucherSource @default(MANUAL)
  status VoucherStatus @default(DRAFT)

  date          DateTime @db.Date
  narration     String   @db.VarChar(500)
  /// Human-facing pointer (an invoice number, a receipt number).
  reference     String?  @db.VarChar(120)
  /// Machine idempotency key — see the model doc.
  sourceRef     String?  @map("source_ref") @db.VarChar(120)
  attachmentUrl String?  @map("attachment_url") @db.VarChar(500)

  fiscalPeriodId String?       @map("fiscal_period_id") @db.Uuid
  fiscalPeriod   FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict, map: "fk_vouchers_fiscal_period")

  postedBy String?   @map("posted_by") @db.Uuid
  postedAt DateTime? @map("posted_at") @db.Timestamptz(6)

  cancelledBy         String?   @map("cancelled_by") @db.Uuid
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason        String?   @map("cancel_reason") @db.VarChar(500)
  /// Set on the reversal voucher, pointing at what it reverses.
  reversalOfVoucherId String?   @map("reversal_of_voucher_id") @db.Uuid
  reversalOf          Voucher?  @relation("VoucherReversal", fields: [reversalOfVoucherId], references: [id], onDelete: Restrict, map: "fk_vouchers_reversal_of")
  reversedBy          Voucher[] @relation("VoucherReversal")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  entries VoucherEntry[]

  // Voucher numbers are never reused, so this unique deliberately
  // IGNORES `deleted_at` (the M07 employee-ID / M16 invoice precedent).
  // The `source_ref` idempotency unique is partial and hand-written.
  @@unique([schoolId, voucherNo], map: "uq_vouchers_no")
  @@index([schoolId, date, status], map: "idx_vouchers_school_date_status")
  @@index([schoolId, source, status], map: "idx_vouchers_source")
  @@map("vouchers")
}

/// One line of a voucher. Hard-deleted with its voucher and replaced as a
/// set while the voucher is a DRAFT (the M13 `timetable_entries` / M19
/// `gallery_items` precedent) — a half-edited voucher is worse than none,
/// and once POSTED the lines never move again.
///
/// A line is one-sided by CHECK (`debit = 0 OR credit = 0`) and non-zero
/// (`debit + credit > 0`): a line that is both, or neither, is not an
/// entry a ledger can read.
model VoucherEntry {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  school    School  @relation(fields: [schoolId], references: [id], map: "fk_voucher_entries_school")
  voucherId String  @map("voucher_id") @db.Uuid
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade, map: "fk_voucher_entries_voucher")
  accountId String  @map("account_id") @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "fk_voucher_entries_account")

  debit        Decimal @default(0) @db.Decimal(12, 2)
  credit       Decimal @default(0) @db.Decimal(12, 2)
  narration    String? @db.VarChar(300)
  displayOrder Int     @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([voucherId, displayOrder], map: "idx_voucher_entries_voucher")
  @@index([accountId], map: "idx_voucher_entries_account")
  @@map("voucher_entries")
}

/// What a school planned to earn or spend on one account for a session.
/// Keyed on the session rather than a fiscal period because that is the
/// unit a school budgets in; `month` narrows a MONTHLY row and is NULL on
/// a YEARLY one (a CHECK pins the pair, and the identity index maps NULL
/// to 0 — the M06 COALESCE trick).
model Budget {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String          @map("school_id") @db.Uuid
  school    School          @relation(fields: [schoolId], references: [id], map: "fk_budgets_school")
  sessionId String          @map("session_id") @db.Uuid
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_budgets_session")
  accountId String          @map("account_id") @db.Uuid
  account   Account         @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "fk_budgets_account")

  period BudgetPeriod @default(YEARLY)
  /// 1–12 for a MONTHLY row, NULL for a YEARLY one.
  month  Int?
  amount Decimal      @db.Decimal(12, 2)
  note   String?      @db.VarChar(300)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([schoolId, sessionId], map: "idx_budgets_scope")
  @@index([accountId], map: "idx_budgets_account")
  @@map("budgets")
}

/// The accounting year (or the months inside it). CLOSED locks every
/// voucher dated inside it — the whole point of a close is that last
/// year's trial balance stops moving. Reopening is a permission
/// (`accounting.period.reopen`) and an audit entry, never a quiet edit.
model FiscalPeriod {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], map: "fk_fiscal_periods_school")

  name      String             @db.VarChar(100)
  startDate DateTime           @map("start_date") @db.Date
  endDate   DateTime           @map("end_date") @db.Date
  status    FiscalPeriodStatus @default(OPEN)

  closedBy    String?   @map("closed_by") @db.Uuid
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  reopenedBy  String?   @map("reopened_by") @db.Uuid
  reopenedAt  DateTime? @map("reopened_at") @db.Timestamptz(6)
  closingNote String?   @map("closing_note") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  vouchers Voucher[]

  @@index([schoolId, startDate, endDate], map: "idx_fiscal_periods_range")
  @@map("fiscal_periods")
}

/// The bridge between operations and the ledger: which account a fee
/// head's income lands in, which cash/bank/clearing account a payment
/// method settles to, and the handful of system slots (receivable,
/// discount, late fine, gateway charges, opening equity) auto-posting
/// needs by name. Kind + key rather than a column per mapping, so M21
/// payroll and M24 inventory register their own without a migration.
model PostingMap {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String         @map("school_id") @db.Uuid
  school    School         @relation(fields: [schoolId], references: [id], map: "fk_posting_maps_school")
  kind      PostingMapKind
  /// A fee-head UUID, a `payment_method_enum` value, or a system slug.
  refKey    String         @map("ref_key") @db.VarChar(80)
  accountId String         @map("account_id") @db.Uuid
  account   Account        @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "fk_posting_maps_account")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // `uq_posting_maps_key` is partial (live rows) and hand-written.
  @@index([schoolId, kind], map: "idx_posting_maps_kind")
  @@index([accountId], map: "idx_posting_maps_account")
  @@map("posting_maps")
}

// ── Module 21: HR & Payroll ───────────────────────────────────────────

/// A named leave entitlement (Casual, Sick, Maternity, Unpaid…). This
/// TABLE replaces the M08 `leave_type_enum`: a taxonomy that carries an
/// annual quota, a carry-forward rule and a paid/unpaid flag is data, not
/// a type. `is_paid = false` is what makes payroll deduct the days.
model LeaveType {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String            @map("school_id") @db.Uuid
  school       School            @relation(fields: [schoolId], references: [id], map: "fk_leave_types_school")
  name         String            @db.VarChar(80)
  /// Stable short handle (CASUAL, SICK…) — the M08 migration keys on it.
  code         String            @db.VarChar(30)
  annualQuota  Decimal           @default(0) @map("annual_quota") @db.Decimal(5, 1)
  carryForward Boolean           @default(false) @map("carry_forward")
  maxCarry     Decimal           @default(0) @map("max_carry") @db.Decimal(5, 1)
  isPaid       Boolean           @default(true) @map("is_paid")
  applicableTo LeaveApplicableTo @default(ALL) @map("applicable_to")
  isActive     Boolean           @default(true) @map("is_active")
  displayOrder Int               @default(0) @map("display_order")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  balances     LeaveBalance[]
  applications LeaveApplication[]

  // `uq_leave_types_code` is partial (live rows) and hand-written.
  @@index([schoolId, isActive], map: "idx_leave_types_school_active")
  @@map("leave_types")
}

/// One employee's entitlement of one leave type for one session.
/// Polymorphic over `teachers` / `staff_profiles` (`person_type` +
/// `person_id`, no FK — the M12 `staff_attendances` decision). `used` is
/// maintained by the approval flow, never typed in; what an employee may
/// still take is `allocated + carried - used`.
model LeaveBalance {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String               @map("school_id") @db.Uuid
  school      School               @relation(fields: [schoolId], references: [id], map: "fk_leave_balances_school")
  personType  AttendancePersonType @map("person_type")
  personId    String               @map("person_id") @db.Uuid
  sessionId   String               @map("session_id") @db.Uuid
  session     AcademicSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_leave_balances_session")
  leaveTypeId String               @map("leave_type_id") @db.Uuid
  leaveType   LeaveType            @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict, map: "fk_leave_balances_type")

  allocated Decimal @default(0) @db.Decimal(5, 1)
  used      Decimal @default(0) @db.Decimal(5, 1)
  carried   Decimal @default(0) @db.Decimal(5, 1)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // `uq_leave_balances_identity` is partial (live rows) and hand-written.
  @@index([schoolId, sessionId], map: "idx_leave_balances_scope")
  @@index([personType, personId], map: "idx_leave_balances_person")
  @@map("leave_balances")
}

/// The unified leave application — the M08 `teacher_leaves` successor,
/// covering staff as well and hanging off a `leave_types` row. `days` is
/// stored rather than derived, because the working-day calendar it was
/// counted against can be edited afterwards and an approved leave must
/// not silently start consuming a different amount of quota.
///
/// `approver_chain` records who acted, in order (roadmap §3). A school
/// with a single approver keeps a one-element array; the column exists so
/// a multi-step chain needs no migration.
model LeaveApplication {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String               @map("school_id") @db.Uuid
  school      School               @relation(fields: [schoolId], references: [id], map: "fk_leave_applications_school")
  personType  AttendancePersonType @map("person_type")
  personId    String               @map("person_id") @db.Uuid
  leaveTypeId String               @map("leave_type_id") @db.Uuid
  leaveType   LeaveType            @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict, map: "fk_leave_applications_type")
  /// The session the days fall in — the balance they consume is per session.
  sessionId   String?              @map("session_id") @db.Uuid

  fromDate DateTime @map("from_date") @db.Date
  toDate   DateTime @map("to_date") @db.Date
  halfDay  Boolean  @default(false) @map("half_day")
  days     Decimal  @db.Decimal(4, 1)
  reason   String

  status        LeaveStatus @default(PENDING)
  approverChain Json        @default("[]") @map("approver_chain")
  approvedBy    String?     @map("approved_by") @db.Uuid
  approvedAt    DateTime?   @map("approved_at") @db.Timestamptz(6)
  decisionNote  String?     @map("decision_note")
  /// S3 object key (a medical certificate, a duty order).
  attachmentUrl String?     @map("attachment_url") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([schoolId, status], map: "idx_leave_applications_school_status")
  @@index([personType, personId, fromDate], map: "idx_leave_applications_person")
  @@index([schoolId, fromDate, toDate], map: "idx_leave_applications_range")
  @@map("leave_applications")
}

/// A reusable pay scale: a basic figure plus the allowance/deduction
/// lines computed from it. Assigning it to a person is a separate row
/// (`employee_salaries`), so raising House Rent for everyone on the scale
/// is one edit and every future payslip follows.
model SalaryStructure {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId    String  @map("school_id") @db.Uuid
  school      School  @relation(fields: [schoolId], references: [id], map: "fk_salary_structures_school")
  name        String  @db.VarChar(120)
  /// Optional government pay-scale grade this mirrors (BD national scale).
  grade       String? @db.VarChar(30)
  basic       Decimal @db.Decimal(12, 2)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  components SalaryComponent[]
  salaries   EmployeeSalary[]

  // `uq_salary_structures_name` is partial (live rows) and hand-written.
  @@index([schoolId, isActive], map: "idx_salary_structures_school_active")
  @@map("salary_structures")
}

/// One line of a structure. **Hard-deleted** and replaced as a set while
/// editing (the M13 `timetable_entries` / M19 `gallery_items` / M20
/// `voucher_entries` precedent) — a structure is authored as a whole, and
/// a half-saved scale would compute a wrong payslip.
///
/// `is_taxable` and `is_pf_base` are what the tax and provident-fund
/// engines read: a conveyance allowance is usually neither.
model SalaryComponent {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String              @map("school_id") @db.Uuid
  school       School              @relation(fields: [schoolId], references: [id], map: "fk_salary_components_school")
  structureId  String              @map("structure_id") @db.Uuid
  structure    SalaryStructure     @relation(fields: [structureId], references: [id], onDelete: Cascade, map: "fk_salary_components_structure")
  name         String              @db.VarChar(80)
  type         SalaryComponentType
  calc         SalaryCalc          @default(FLAT)
  value        Decimal             @db.Decimal(12, 2)
  isTaxable    Boolean             @default(true) @map("is_taxable")
  isPfBase     Boolean             @default(false) @map("is_pf_base")
  displayOrder Int                 @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([structureId, displayOrder], map: "idx_salary_components_structure")
  @@map("salary_components")
}

/// Who is on which scale, from when. **History-preserving**: a change
/// writes a NEW row rather than updating the old one (roadmap §3), so a
/// payslip re-generated for March still reads March's salary. The row in
/// force for a month is the latest `effective_from` on or before it.
///
/// `basic_override` also serves the MPO case the roadmap names in §8: a
/// government-paid teacher sits on a structure with a zero basic and
/// draws only the school's allowances.
model EmployeeSalary {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId      String               @map("school_id") @db.Uuid
  school        School               @relation(fields: [schoolId], references: [id], map: "fk_employee_salaries_school")
  personType    AttendancePersonType @map("person_type")
  personId      String               @map("person_id") @db.Uuid
  structureId   String               @map("structure_id") @db.Uuid
  structure     SalaryStructure      @relation(fields: [structureId], references: [id], onDelete: Restrict, map: "fk_employee_salaries_structure")
  basicOverride Decimal?             @map("basic_override") @db.Decimal(12, 2)
  effectiveFrom DateTime             @map("effective_from") @db.Date
  /// { bankName, branchName, accountNo, accountName, routingNo } — the
  /// bank-advice sheet reads it; required when paymentMode = BANK.
  bankAccount   Json?                @map("bank_account")
  paymentMode   PaymentMode          @default(BANK) @map("payment_mode")
  note          String?              @db.VarChar(300)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // `uq_employee_salaries_identity` is partial (live rows) and hand-written:
  // one assignment per person per effective date, so re-saving a correction
  // for the same date replaces it instead of stacking a second history row.
  @@index([schoolId, personType, personId], map: "idx_employee_salaries_person")
  @@index([structureId], map: "idx_employee_salaries_structure")
  @@map("employee_salaries")
}

/// One month's payroll. `month` is stored as the first day of the month
/// (a DATE, like every other calendar value here). One live run per month
/// — a hand-written partial unique excludes CANCELLED rows so a cancelled
/// run frees the month (the M11 enrollment rule).
model PayrollRun {
  id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String           @map("school_id") @db.Uuid
  school   School           @relation(fields: [schoolId], references: [id], map: "fk_payroll_runs_school")
  month    DateTime         @db.Date
  status   PayrollRunStatus @default(DRAFT)
  note     String?          @db.VarChar(500)

  /// Working days the month was computed against — frozen at generation,
  /// because the holiday calendar may be edited afterwards and a payslip
  /// must stay reproducible.
  workingDays Int?    @map("working_days")
  /// Cached totals so a run list does not aggregate every payslip.
  grossTotal  Decimal @default(0) @map("gross_total") @db.Decimal(12, 2)
  netTotal    Decimal @default(0) @map("net_total") @db.Decimal(12, 2)

  generatedBy  String?   @map("generated_by") @db.Uuid
  generatedAt  DateTime? @map("generated_at") @db.Timestamptz(6)
  approvedBy   String?   @map("approved_by") @db.Uuid
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  disbursedBy  String?   @map("disbursed_by") @db.Uuid
  disbursedAt  DateTime? @map("disbursed_at") @db.Timestamptz(6)
  /// The M20 voucher this run posted, once disbursed.
  voucherId    String?   @map("voucher_id") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  payslips Payslip[]

  @@index([schoolId, month], map: "idx_payroll_runs_school_month")
  @@map("payroll_runs")
}

/// One employee's pay for one run. Every figure is stored rather than
/// recomputed on read: the structure, the attendance and the tax slabs
/// can all move afterwards, and a payslip already handed over is a
/// document, not a query (the M14/M15 snapshot rule).
///
/// `breakdown` keeps the line-by-line detail the PDF prints — component
/// names with their computed amounts, the bonus lines, and any ad-hoc
/// line added with a reason (roadmap §8's exam-committee allowance).
model Payslip {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String               @map("school_id") @db.Uuid
  school       School               @relation(fields: [schoolId], references: [id], map: "fk_payslips_school")
  payrollRunId String               @map("payroll_run_id") @db.Uuid
  payrollRun   PayrollRun           @relation(fields: [payrollRunId], references: [id], onDelete: Cascade, map: "fk_payslips_run")
  personType   AttendancePersonType @map("person_type")
  personId     String               @map("person_id") @db.Uuid
  /// Denormalised at generation — an employee may be renamed or deleted,
  /// and last March's payslip still has to print the name it was issued to.
  personName   String               @map("person_name") @db.VarChar(200)
  employeeId   String               @map("employee_id") @db.VarChar(30)
  designation  String?              @db.VarChar(80)

  basic               Decimal @db.Decimal(12, 2)
  totalAllowances     Decimal @default(0) @map("total_allowances") @db.Decimal(12, 2)
  gross               Decimal @default(0) @db.Decimal(12, 2)
  totalDeductions     Decimal @default(0) @map("total_deductions") @db.Decimal(12, 2)
  attendanceDeduction Decimal @default(0) @map("attendance_deduction") @db.Decimal(12, 2)
  tax                 Decimal @default(0) @db.Decimal(12, 2)
  pfEmployee          Decimal @default(0) @map("pf_employee") @db.Decimal(12, 2)
  pfEmployer          Decimal @default(0) @map("pf_employer") @db.Decimal(12, 2)
  bonus               Decimal @default(0) @db.Decimal(12, 2)
  netPayable          Decimal @default(0) @map("net_payable") @db.Decimal(12, 2)

  daysPresent     Decimal @default(0) @map("days_present") @db.Decimal(4, 1)
  daysLeavePaid   Decimal @default(0) @map("days_leave_paid") @db.Decimal(4, 1)
  daysAbsent      Decimal @default(0) @map("days_absent") @db.Decimal(4, 1)
  daysUnpaidLeave Decimal @default(0) @map("days_unpaid_leave") @db.Decimal(4, 1)
  workingDays     Int     @default(0) @map("working_days")

  breakdown   Json          @default("{}")
  status      PayslipStatus @default(PENDING)
  holdReason  String?       @map("hold_reason") @db.VarChar(300)
  paymentMode PaymentMode   @default(BANK) @map("payment_mode")
  paidAt      DateTime?     @map("paid_at") @db.Timestamptz(6)
  /// Set when a figure was overridden by hand on the draft (roadmap §5).
  editReason  String?       @map("edit_reason") @db.VarChar(300)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // `uq_payslips_person` is partial (live rows) and hand-written: one
  // payslip per person per run, which is what makes regeneration an
  // idempotent replace rather than a duplicate.
  @@index([payrollRunId], map: "idx_payslips_run")
  @@index([schoolId, personType, personId], map: "idx_payslips_person")
  @@map("payslips")
}

/// A bonus round ("Eid-ul-Fitr Bonus 2027") attached to the month it is
/// paid with. Eligibility is a minimum service length; `prorate` decides
/// whether somebody four months short gets a fraction or nothing.
model BonusRun {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId         String            @map("school_id") @db.Uuid
  school           School            @relation(fields: [schoolId], references: [id], map: "fk_bonus_runs_school")
  name             String            @db.VarChar(120)
  type             BonusType         @default(FESTIVAL)
  basis            BonusBasis        @default(PERCENT_OF_BASIC)
  value            Decimal           @db.Decimal(12, 2)
  /// The payroll month this bonus rides along with (first of the month).
  monthPaidWith    DateTime?         @map("month_paid_with") @db.Date
  minServiceMonths Int               @default(0) @map("min_service_months")
  prorate          Boolean           @default(false)
  applicableTo     LeaveApplicableTo @default(ALL) @map("applicable_to")
  isActive         Boolean           @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([schoolId, monthPaidWith], map: "idx_bonus_runs_month")
  @@map("bonus_runs")
}

/// The provident-fund passbook: **append-only** (no soft delete — the M17
/// `sms_credits` / M03 `audit_logs` rule), one row per movement, each
/// carrying the running `balance_after` so a statement never has to
/// re-add the whole history to answer "what is in the fund".
model PfLedgerEntry {
  id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String               @map("school_id") @db.Uuid
  school     School               @relation(fields: [schoolId], references: [id], map: "fk_pf_ledger_school")
  personType AttendancePersonType @map("person_type")
  personId   String               @map("person_id") @db.Uuid
  /// First day of the month the movement belongs to.
  month      DateTime             @db.Date
  type       PfEntryType          @default(CONTRIBUTION)

  employeeAmt  Decimal @default(0) @map("employee_amt") @db.Decimal(12, 2)
  employerAmt  Decimal @default(0) @map("employer_amt") @db.Decimal(12, 2)
  balanceAfter Decimal @map("balance_after") @db.Decimal(12, 2)
  /// The payslip that produced a CONTRIBUTION row; NULL for hand entries.
  payslipId    String? @map("payslip_id") @db.Uuid
  note         String? @db.VarChar(300)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  // `uq_pf_ledger_payslip` is partial and hand-written — one contribution
  // row per payslip, which is what makes a re-run idempotent.
  @@index([schoolId, personType, personId, month], map: "idx_pf_ledger_person_month")
  @@map("pf_ledger")
}

// ── Module 22: Assignments & Homework ─────────────────────────────────

/// A piece of work a teacher sets one section in one subject. The
/// section+subject pair is what the ownership policy is checked against
/// — deliberately re-read from `teacher_section_subjects` at every write
/// rather than trusted from `teacher_id`, so a reassigned teacher
/// inherits evaluation rights without a data migration (roadmap §8).
///
/// `assigned_at` is when the work is set and `due_at` when it is due;
/// both are wall-clock instants rather than dates, because "due Thursday"
/// at a BD school means a time of day, and a submission arriving at
/// 23:59 rather than 00:01 is exactly the case `is_late` has to decide.
model Assignment {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String          @map("school_id") @db.Uuid
  school    School          @relation(fields: [schoolId], references: [id], map: "fk_assignments_school")
  sessionId String          @map("session_id") @db.Uuid
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_assignments_session")
  sectionId String          @map("section_id") @db.Uuid
  section   Section         @relation(fields: [sectionId], references: [id], map: "fk_assignments_section")
  subjectId String          @map("subject_id") @db.Uuid
  subject   Subject         @relation(fields: [subjectId], references: [id], map: "fk_assignments_subject")
  /// Who set it. Kept for attribution and the "my assignments" filter; it
  /// is deliberately NOT the authorization — see the model doc.
  teacherId String          @map("teacher_id") @db.Uuid
  teacher   Teacher         @relation(fields: [teacherId], references: [id], map: "fk_assignments_teacher")

  type           AssignmentType @default(ASSIGNMENT)
  title          String         @db.VarChar(200)
  /// Author HTML, sanitized on WRITE through the M19 allow-list sanitizer
  /// — a student portal renders this, so the stored row is the guarantee
  /// rather than every future reader's memory.
  instructions   String?
  /// `[{ key, name, size, contentType }]` — S3 object keys, signed on read.
  attachmentUrls Json           @default("[]") @map("attachment_urls")

  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  dueAt      DateTime @map("due_at") @db.Timestamptz(6)
  /// NULL means the work is not graded — feedback only.
  fullMarks  Decimal? @map("full_marks") @db.Decimal(6, 2)
  allowLate  Boolean  @default(false) @map("allow_late")

  status      AssignmentStatus @default(DRAFT)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(6)
  closedAt    DateTime?        @map("closed_at") @db.Timestamptz(6)

  /// Job idempotency, the M12 `absent_notified_at` pattern: a column on
  /// the row the job acts on beats a second table nobody reads.
  dueReminderSentAt   DateTime? @map("due_reminder_sent_at") @db.Timestamptz(6)
  noSubmissionAlertAt DateTime? @map("no_submission_alert_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  submissions AssignmentSubmission[]

  @@index([schoolId, sessionId, sectionId], map: "idx_assignments_scope")
  @@index([schoolId, teacherId, status], map: "idx_assignments_teacher")
  @@index([schoolId, status, dueAt], map: "idx_assignments_due")
  @@map("assignments")
}

/// One candidate's answer to one assignment, keyed on **`enrollment_id`**
/// like every other academic record (attendance, marks, fees). No soft
/// delete: a resubmission replaces the row in place so its id stays
/// stable for the evaluation hanging off it — the same reasoning `marks`
/// uses, and what lets `uq_assignment_submissions_identity` be a plain
/// unique rather than a partial one.
///
/// `is_late` is **stored, not derived**. Extending a deadline afterwards
/// must not silently rewrite what last week's submission report said;
/// forgiving a late submission is the teacher's call at evaluation, not a
/// side effect of moving a date (the M21 stored-`days` reasoning).
model AssignmentSubmission {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId     String     @map("school_id") @db.Uuid
  school       School     @relation(fields: [schoolId], references: [id], map: "fk_assignment_submissions_school")
  assignmentId String     @map("assignment_id") @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, map: "fk_assignment_submissions_assignment")
  enrollmentId String     @map("enrollment_id") @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade, map: "fk_assignment_submissions_enrollment")

  textAnswer     String? @map("text_answer")
  attachmentUrls Json    @default("[]") @map("attachment_urls")

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  isLate      Boolean  @default(false) @map("is_late")
  /// How many times this candidate has submitted; 1 on the first save.
  attempt     Int      @default(1)

  marks       Decimal?         @db.Decimal(6, 2)
  feedback    String?
  evaluatedBy String?          @map("evaluated_by") @db.Uuid
  evaluatedAt DateTime?        @map("evaluated_at") @db.Timestamptz(6)
  status      SubmissionStatus @default(SUBMITTED)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([assignmentId, enrollmentId], map: "uq_assignment_submissions_identity")
  @@index([schoolId, enrollmentId], map: "idx_assignment_submissions_enrollment")
  @@index([assignmentId, status], map: "idx_assignment_submissions_status")
  @@map("assignment_submissions")
}

/// Class notes, slides, a video link — the library beside the homework.
/// `section_id` NULL means class-wide, which is why `class_id` is stored
/// alongside it rather than read through the section: a class-wide note
/// has no section to read a class from.
model LearningMaterial {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId  String          @map("school_id") @db.Uuid
  school    School          @relation(fields: [schoolId], references: [id], map: "fk_learning_materials_school")
  sessionId String          @map("session_id") @db.Uuid
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "fk_learning_materials_session")
  classId   String          @map("class_id") @db.Uuid
  class     SchoolClass     @relation(fields: [classId], references: [id], map: "fk_learning_materials_class")
  /// NULL = every section of the class.
  /// RESTRICT, not Prisma's default SET NULL for an optional relation:
  /// NULL means "class-wide" here, so a deleted section would silently
  /// promote its private material to the whole class.
  sectionId String?         @map("section_id") @db.Uuid
  section   Section?        @relation(fields: [sectionId], references: [id], onDelete: Restrict, map: "fk_learning_materials_section")
  subjectId String          @map("subject_id") @db.Uuid
  subject   Subject         @relation(fields: [subjectId], references: [id], map: "fk_learning_materials_subject")
  teacherId String          @map("teacher_id") @db.Uuid
  teacher   Teacher         @relation(fields: [teacherId], references: [id], map: "fk_learning_materials_teacher")

  type        LearningMaterialType @default(NOTE)
  title       String               @db.VarChar(200)
  description String?
  fileUrls    Json                 @default("[]") @map("file_urls")
  /// The external https URL a VIDEO_URL/LINK material points at.
  linkUrl     String?              @map("link_url") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([schoolId, sessionId, classId], map: "idx_learning_materials_scope")
  @@index([schoolId, subjectId], map: "idx_learning_materials_subject")
  @@index([schoolId, teacherId], map: "idx_learning_materials_teacher")
  @@map("learning_materials")
}

// â”€â”€ Module 23: Library Management â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// Shelf classification (Fiction, Science, Referenceâ€¦). A master in the
/// M06 sense: session-independent, soft-deleted, unique per school among
/// live rows.
model BookCategory {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], map: "fk_book_categories_school")

  name        String  @db.VarChar(120)
  nameBn      String? @map("name_bn") @db.VarChar(120)
  description String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  books Book[]

  @@index([schoolId], map: "idx_book_categories_school")
  @@map("book_categories")
}

model Author {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], map: "fk_authors_school")

  name   String  @db.VarChar(160)
  nameBn String? @map("name_bn") @db.VarChar(160)
  /// Free text â€” "Bangladeshi novelist, 1948-2012". Not a biography.
  note   String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  books BookAuthor[]

  @@index([schoolId], map: "idx_authors_school")
  @@map("authors")
}

model Publisher {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], map: "fk_publishers_school")

  name    String  @db.VarChar(160)
  nameBn  String? @map("name_bn") @db.VarChar(160)
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(160)
  address String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  books Book[]

  @@index([schoolId], map: "idx_publishers_school")
  @@map("publishers")
}

/// The **title** â€” the bibliographic record. What a school owns is a
/// `BookCopy`; what a reader searches for is this. Roadmap Â§8's "same
/// title, different edition => separate books" falls out of that: the
/// edition is a column here, so two editions are two rows and their
/// copies never mix on the shelf list.
///
/// `isbn` is nullable and deliberately NOT unique. A BD school's shelves
/// carry locally-printed guides with no ISBN at all, donated copies of
/// the same ISBN catalogued twice by two librarians, and textbooks whose
/// ISBN is reprinted unchanged across editions. A checksum is validated
/// on write (`isbn.util.ts`); uniqueness would refuse real books.
model Book {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], map: "fk_books_school")

  title   String  @db.VarChar(250)
  titleBn String? @map("title_bn") @db.VarChar(250)
  /// Digits only, hyphens stripped, checksum-validated on write.
  isbn    String? @db.VarChar(17)

  categoryId  String       @map("category_id") @db.Uuid
  category    BookCategory @relation(fields: [categoryId], references: [id], map: "fk_books_category")
  publisherId String?      @map("publisher_id") @db.Uuid
  publisher   Publisher?   @relation(fields: [publisherId], references: [id], onDelete: Restrict, map: "fk_books_publisher")

  edition     String?  @db.VarChar(60)
  language    String   @default("English") @db.VarChar(40)
  /// Replacement value. Drives the lost/damaged charge; a book with no
  /// price falls back to `library.default_book_price` rather than
  /// charging nothing, because a lost book that costs a school nothing
  /// is a lost book nobody bothers to return.
  price       Decimal? @db.Decimal(12, 2)
  coverUrl    String?  @map("cover_url") @db.VarChar(500)
  /// Where it physically lives â€” the one field a stock-take reads most.
  rackNo      String?  @map("rack_no") @db.VarChar(40)
  description String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  authors      BookAuthor[]
  copies       BookCopy[]
  reservations BookReservation[]

  @@index([schoolId, categoryId], map: "idx_books_category")
  @@index([schoolId, title], map: "idx_books_title")
  @@index([schoolId, isbn], map: "idx_books_isbn")
  @@map("books")
}

/// Title <-> author, ordered. **Hard-deleted and replaced as a set** when
/// a book's author list is edited â€” the M13 `timetable_entries` / M19
/// `gallery_items` / M20 `voucher_entries` precedent.
model BookAuthor {
  bookId   String @map("book_id") @db.Uuid
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade, map: "fk_book_authors_book")
  authorId String @map("author_id") @db.Uuid
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade, map: "fk_book_authors_author")
  /// 0 = first-named author, which is how a spine label is written.
  position Int    @default(0)

  @@id([bookId, authorId])
  @@index([authorId], map: "idx_book_authors_author")
  @@map("book_authors")
}

/// One physical volume on one shelf. `accession_no` is the barcode value
/// written inside the cover, and its unique index deliberately **ignores
/// `deleted_at`** â€” the M07 employee-ID / M09 student-UID rule. An
/// accession number is a label stuck in a book; re-issuing one to a
/// different volume would make a twenty-year-old stock register lie.
model BookCopy {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], map: "fk_book_copies_school")
  bookId   String @map("book_id") @db.Uuid
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Restrict, map: "fk_book_copies_book")

  accessionNo   String         @map("accession_no") @db.VarChar(40)
  status        BookCopyStatus @default(AVAILABLE)
  condition     BookCondition  @default(NEW)
  /// Free text beside the condition â€” roadmap Â§8's damaged-on-return
  /// dispute is settled by what the librarian wrote, not by the enum.
  conditionNote String?        @map("condition_note")
  /// What the school paid for this volume, when it differs from the
  /// title's list price (a donated copy is 0, a reprint may be cheaper).
  purchasePrice Decimal?       @map("purchase_price") @db.Decimal(12, 2)
  addedAt       DateTime       @default(now()) @map("added_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  issues BookIssue[]
  scans  StockVerificationScan[]

  /// The one unique in this module that deliberately IGNORES
  /// `deleted_at` — see the model doc.
  @@unique([schoolId, accessionNo], map: "uq_book_copies_accession")
  @@index([schoolId, bookId, status], map: "idx_book_copies_book")
  @@index([schoolId, status], map: "idx_book_copies_status")
  @@map("book_copies")
}

/// The card. Polymorphic over students/teachers/staff with no FK (the
/// M12/M21 precedent), because the three tables share no supertype and a
/// card belongs to a person rather than to a role.
///
/// `max_books` is **stored on the member**, not read from settings at
/// issue time. The settings value seeds it; a librarian raising one
/// student's limit for a project must not have to raise everybody's, and
/// a school editing `library.max_books_student` must not silently
/// re-limit the members it already granted an exception to.
model LibraryMember {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId   String            @map("school_id") @db.Uuid
  school     School            @relation(fields: [schoolId], references: [id], map: "fk_library_members_school")
  personType LibraryMemberType @map("person_type")
  /// students.id | teachers.id | staff_profiles.id â€” no FK by design.
  personId   String            @map("person_id") @db.Uuid

  cardNo       String              @map("card_no") @db.VarChar(40)
  maxBooks     Int                 @default(2) @map("max_books")
  status       LibraryMemberStatus @default(ACTIVE)
  joinedAt     DateTime            @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// Why the card was suspended or closed â€” the M07 status-reason rule.
  statusReason String?             @map("status_reason")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  issues       BookIssue[]
  reservations BookReservation[]

  /// Printed on a physical card, so never reused — the same reasoning
  /// `uq_book_copies_accession` carries. The *person* identity unique is
  /// partial (live cards only) and lives in the migration.
  @@unique([schoolId, cardNo], map: "uq_library_members_card")
  @@index([schoolId, status], map: "idx_library_members_status")
  @@index([schoolId, personType, personId], map: "idx_library_members_person")
  @@map("library_members")
}

/// One loan. **Not soft-deletable** â€” a loan is history, and the M20
/// "corrections are reversals" rule applies: a wrongly-issued copy is
/// returned, not erased. Which is also what lets the one-open-loan-per-
/// copy rule be a partial unique over `returned_at IS NULL` rather than
/// something a service has to remember.
///
/// The fine columns are the module's money. `fine_amount` is what was
/// assessed, `fine_collected` and `fine_waived` are the two ways it goes
/// away, and `fine_paid` is **derived by CHECK** rather than assigned â€”
/// the M16 `deriveStatus` rule pinned at the database, so no write path
/// can leave the flag disagreeing with the arithmetic beside it.
model BookIssue {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String        @map("school_id") @db.Uuid
  school   School        @relation(fields: [schoolId], references: [id], map: "fk_book_issues_school")
  copyId   String        @map("copy_id") @db.Uuid
  copy     BookCopy      @relation(fields: [copyId], references: [id], onDelete: Restrict, map: "fk_book_issues_copy")
  memberId String        @map("member_id") @db.Uuid
  member   LibraryMember @relation(fields: [memberId], references: [id], onDelete: Restrict, map: "fk_book_issues_member")

  issuedAt   DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// End of the loan, stored as an instant like M22's `due_at`: the desk
  /// hands a book over at a time of day and the fine engine counts whole
  /// days from it.
  dueAt      DateTime  @map("due_at") @db.Timestamptz(6)
  returnedAt DateTime? @map("returned_at") @db.Timestamptz(6)
  renewCount Int       @default(0) @map("renew_count")

  fineAmount      Decimal           @default(0) @map("fine_amount") @db.Decimal(12, 2)
  fineCollected   Decimal           @default(0) @map("fine_collected") @db.Decimal(12, 2)
  fineWaived      Decimal           @default(0) @map("fine_waived") @db.Decimal(12, 2)
  fineReason      LibraryFineReason @default(NONE) @map("fine_reason")
  /// Derived â€” see `chk_book_issues_fine_paid`.
  finePaid        Boolean           @default(true) @map("fine_paid")
  fineWaivedBy    String?           @map("fine_waived_by") @db.Uuid
  fineWaiveReason String?           @map("fine_waive_reason")
  fineCollectedAt DateTime?         @map("fine_collected_at") @db.Timestamptz(6)
  /// The M20 voucher this fine receipt posted to, when accounting is on.
  fineVoucherId   String?           @map("fine_voucher_id") @db.Uuid

  /// How many days of the overdue period were charged, and how many were
  /// forgiven as holidays â€” **stored, not recomputed**, for the M21
  /// reason: the calendar they were counted against can be edited
  /// afterwards, and a settled fine must not start disagreeing with the
  /// receipt the member was handed.
  overdueDays Int @default(0) @map("overdue_days")
  holidayDays Int @default(0) @map("holiday_days")

  returnCondition   BookCondition? @map("return_condition")
  issuedBy          String?        @map("issued_by") @db.Uuid
  returnedTo        String?        @map("returned_to") @db.Uuid
  remarks           String?
  /// Idempotency for the weekly overdue chase â€” the M12
  /// `absent_notified_at` column-as-dedupe pattern.
  overdueNotifiedAt DateTime?      @map("overdue_notified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([schoolId, memberId], map: "idx_book_issues_member")
  @@index([schoolId, dueAt], map: "idx_book_issues_due")
  @@index([copyId], map: "idx_book_issues_copy")
  @@map("book_issues")
}

/// A hold on a title. Queue position is `reserved_at` order, which is why
/// there is no explicit rank column: a rank would have to be rewritten
/// every time somebody cancelled, and a timestamp never lies about who
/// asked first.
model BookReservation {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String        @map("school_id") @db.Uuid
  school   School        @relation(fields: [schoolId], references: [id], map: "fk_book_reservations_school")
  bookId   String        @map("book_id") @db.Uuid
  book     Book          @relation(fields: [bookId], references: [id], onDelete: Cascade, map: "fk_book_reservations_book")
  memberId String        @map("member_id") @db.Uuid
  member   LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "fk_book_reservations_member")

  status     BookReservationStatus @default(ACTIVE)
  reservedAt DateTime              @default(now()) @map("reserved_at") @db.Timestamptz(6)
  /// Set when a returned copy is held for this member; the copy goes
  /// RESERVED and waits until here.
  readyAt    DateTime?             @map("ready_at") @db.Timestamptz(6)
  expiresAt  DateTime?             @map("expires_at") @db.Timestamptz(6)
  /// Which copy is being held. Cleared when the hold lapses.
  heldCopyId String?               @map("held_copy_id") @db.Uuid
  closedAt   DateTime?             @map("closed_at") @db.Timestamptz(6)
  notifiedAt DateTime?             @map("notified_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid

  @@index([schoolId, bookId, status], map: "idx_book_reservations_book")
  @@index([schoolId, memberId, status], map: "idx_book_reservations_member")
  @@map("book_reservations")
}

/// A physical stock-take: open one, scan every accession number on the
/// shelves, close it, read the diff (roadmap Â§4). The **expected set is
/// resolved at close, not at open** â€” a book issued during the count is
/// legitimately not on the shelf, and freezing the expectation at open
/// would report it missing.
model StockVerification {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id], map: "fk_stock_verifications_school")

  name        String                  @db.VarChar(160)
  status      StockVerificationStatus @default(IN_PROGRESS)
  /// Optional narrowing â€” one rack at a time is how a stock-take is
  /// actually done. NULL means the whole library.
  rackNo      String?                 @map("rack_no") @db.VarChar(40)
  startedAt   DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?               @map("completed_at") @db.Timestamptz(6)

  /// The diff, frozen at close. Recomputing it later would compare
  /// today's shelves against last year's scan (the M14/M15 snapshot rule).
  expectedCount   Int     @default(0) @map("expected_count")
  scannedCount    Int     @default(0) @map("scanned_count")
  missingCount    Int     @default(0) @map("missing_count")
  unexpectedCount Int     @default(0) @map("unexpected_count")
  notes           String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  scans StockVerificationScan[]

  @@index([schoolId, status], map: "idx_stock_verifications_status")
  @@map("stock_verifications")
}

/// One scan. **Hard-deleted** with its parent and replaced as a set â€” a
/// scan log outside its stock-take means nothing.
model StockVerificationScan {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  verificationId String            @map("verification_id") @db.Uuid
  verification   StockVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade, map: "fk_stock_verification_scans_verification")
  /// NULL when the scanned accession number matched no copy at all â€”
  /// which is exactly the row a diff report exists to show, so the raw
  /// string is kept beside it rather than the scan being dropped.
  copyId         String?           @map("copy_id") @db.Uuid
  copy           BookCopy?         @relation(fields: [copyId], references: [id], onDelete: Cascade, map: "fk_stock_verification_scans_copy")
  accessionNo    String            @map("accession_no") @db.VarChar(40)
  scannedAt      DateTime          @default(now()) @map("scanned_at") @db.Timestamptz(6)

  @@index([verificationId], map: "idx_stock_verification_scans_verification")
  @@index([copyId], map: "idx_stock_verification_scans_copy")
  @@map("stock_verification_scans")
}
